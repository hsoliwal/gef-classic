+    /**
+     * The XML header and testcase elements must count every invocation,
+     * including multiple successful executions with one method name.
+     */
+    public void testCountsRepeatedMethodNameInvocationsInXml() throws IOException {
+        ReportEntry first = new SimpleReportEntry(NORMAL_RUN, 0L, getClass().getName(), null, TEST_ONE, null, 12);
+        ReportEntry second = new SimpleReportEntry(NORMAL_RUN, 0L, getClass().getName(), null, TEST_ONE, null, 13);
+        WrappedReportEntry firstRun =
+                new WrappedReportEntry(first, SUCCESS, 1771085631L, 12, null, null, systemProps());
+        WrappedReportEntry secondRun =
+                new WrappedReportEntry(second, SUCCESS, 1771085631L, 13, null, null, systemProps());
+        stats.testSucceeded(firstRun);
+        stats.testSucceeded(secondRun);
+        StatelessXmlReporter reporter = new StatelessXmlReporter(
+                reportDir,
+                null,
+                false,
+                0,
+                new ConcurrentHashMap<String, Deque<WrappedReportEntry>>(),
+                XSD,
+                "3.0.2",
+                false,
+                false,
+                false,
+                false,
+                true,
+                true,
+                false);
+        reporter.testSetCompleted(firstRun, stats);
+
+        expectedReportFile = new File(reportDir, "TEST-" + getClass().getName() + ".xml");
+        try (FileInputStream stream = new FileInputStream(expectedReportFile)) {
+            Xpp3Dom suite = Xpp3DomBuilder.build(new InputStreamReader(stream, UTF_8));
+            assertEquals("testsuite", suite.getName());
+            assertEquals("2", suite.getAttribute("tests"));
+            assertEquals(2, suite.getChildren("testcase").length);
+            assertEquals("0", suite.getAttribute("errors"));
+            assertEquals("0", suite.getAttribute("failures"));
+            assertEquals("0", suite.getAttribute("skipped"));
+        }
+    }
+
